# Locast environment configuration template.
#
# Copy this file to `.env` (which is gitignored) and fill in real values
# for the variables your deployment needs. Every variable below is read
# from the process environment by the corresponding component; the file
# is only a convenience for local development. Production deployments
# should source secrets from a secrets manager (AWS SSM, HashiCorp Vault,
# Docker secrets, etc.) rather than from a checked-in file.
#
# None of the placeholder values below are real. Replace `change-me` with
# a strong random value before use. The Locast server will refuse to start
# if a required production secret is set to `change-me`.

# -----------------------------------------------------------------------------
# Signaling server (apps/server)
# -----------------------------------------------------------------------------

# Address the signaling server binds to. Use 0.0.0.0 inside a container
# and 127.0.0.1 for local development. Production should bind to a private
# interface and rely on a reverse proxy (Caddy / nginx) for TLS.
LOCAST_BIND_ADDR=0.0.0.0:8787

# tracing-subscriber EnvFilter. Examples:
#   info
#   info,locast_server=debug
#   warn,locast_server::auth=info
LOCAST_LOG=info

# Database URL for the signaling server. SQLite for v1; Postgres is
# planned for v1.5. The file:// path is for local dev only.
LOCAST_DATABASE_URL=sqlite://./locast-server.db

# Optional password lock for rooms. If unset, rooms are open to anyone
# with the code. If set, viewers must enter the password before joining.
# In production, generate with `openssl rand -base64 32`.
# LOCAST_ROOM_DEFAULT_PASSWORD=change-me

# HMAC secret used to mint short-lived TURN credentials. The server
# shares this with a coturn instance configured with `use-auth-secret`.
# MUST be set in production. Generate with `openssl rand -base64 48`.
# LOCAST_TURN_SHARED_SECRET=change-me

# TTL in seconds for minted TURN credentials. Default 3600 (1 hour).
# LOCAST_TURN_CREDENTIAL_TTL_SECONDS=3600

# Comma-separated STUN/TURN URIs the client should use when direct P2P
# fails. These are public endpoints and are safe to commit.
# LOCAST_TURN_URIS=turn:turn.example.org:3478?transport=udp,turn:turn.example.org:3478?transport=tcp

# -----------------------------------------------------------------------------
# Desktop client (apps/client) - read by the Tauri Rust core
# -----------------------------------------------------------------------------

# Default signaling server the client connects to on first launch.
# Users can change this in Settings; the value here is only the default.
LOCAST_SIGNALING_URL=wss://signal.example.org

# Default STUN/TURN servers. The Locast app always tries direct P2P
# first; these are fallbacks for symmetric NAT / restrictive firewalls.
LOCAST_STUN_URIS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:3478

# -----------------------------------------------------------------------------
# Local development only
# -----------------------------------------------------------------------------

# Set to 1 to enable verbose tracing from the Rust core (sensitive in
# production; do not enable for end users).
# LOCAST_DEV_TRACE=0
