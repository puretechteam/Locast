# cargo-fuzz build output and run products.
target/
artifacts/
coverage/

# libFuzzer writes new corpus entries (hash-named, no extension)
# into corpus/<target>/ during a run. Keep only the committed,
# descriptively named seeds (.msgpack for wire_decode, .txt for
# path_validator, .srt/.vtt/.ass for the subtitle targets).
corpus/*/*
!corpus/*/*.msgpack
!corpus/*/*.txt
!corpus/*/*.srt
!corpus/*/*.vtt
!corpus/*/*.ass
