{
  "name": "locast-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Locast desktop client (Tauri 2 + React).",
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode test --port 1420 --strictPort",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node scripts/run-unit-tests.mjs",
    "smoke:drift": "node --experimental-strip-types --no-warnings src/drift/drift.smoke.ts",
    "smoke:dedup": "node --experimental-strip-types --no-warnings src/drift/dedup.smoke.ts",
    "smoke:geometry": "node --experimental-strip-types --no-warnings src/drawing/geometry.smoke.ts",
    "smoke:stroke-renderer": "node --experimental-strip-types --no-warnings src/drawing/strokeRenderer.smoke.ts",
    "smoke:drawing": "node --experimental-strip-types --no-warnings src/drawing/coalescing.smoke.ts",
    "smoke:drawing-session": "node --experimental-strip-types --no-warnings src/drawing/drawingSession.smoke.ts",
    "smoke:drawing-undo": "node --experimental-strip-types --no-warnings src/drawing/undoPolicy.smoke.ts",
    "smoke:drawing-sync": "node --experimental-strip-types --no-warnings src/drawing/drawingSync.smoke.ts",
    "smoke:laser": "node --experimental-strip-types --no-warnings src/laser/laserTransport.smoke.ts",
    "test:e2e": "playwright test --config=tests/playwright/playwright.config.ts",
    "test:e2e:gate": "playwright test --config=tests/playwright/playwright.config.ts dedup_e2e.spec.ts download_modal.spec.ts drawing_e2e.spec.ts drawing_sync_e2e.spec.ts drift_e2e.spec.ts host_production_e2e.spec.ts laser_transport_e2e.spec.ts library_e2e.spec.ts manual_sync_e2e.spec.ts playback_e2e.spec.ts playback_local_e2e.spec.ts reconnect_status_e2e.spec.ts shared_media_e2e.spec.ts skew_threshold_e2e.spec.ts laser_e2e.spec.ts leave_room_modal_e2e.spec.ts permission_e2e.spec.ts chat_e2e.spec.ts",
    "test:e2e:summary": "node scripts/e2e-summary.mjs",
    "test:perf": "playwright test --config=tests/perf/playwright.config.ts",
    "perf:flag": "node tests/perf/flag-long-tasks.mjs",
    "lint": "eslint . --max-warnings 0",
    "tauri": "tauri",
    "bundle:windows": "tauri build --bundles msi",
    "bundle:macos": "tauri build --bundles dmg",
    "bundle:linux": "tauri build --bundles deb,appimage"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": ">=22.6"
  }
}
